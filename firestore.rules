rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      // A user can read, create, and update their own profile
      allow read, update: if isOwner(userId);
      // A new user can create their own profile document
      allow create: if request.auth.uid != null && request.resource.id == request.auth.uid;
    }

    // Rules for documents and their sub-collections
    match /users/{userId}/documents/{documentId} {
      // A user can do anything with documents in their own space
      allow read, write, delete: if isOwner(userId);

      // Rules for the 'chats' sub-collection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'summaries' sub-collection
      match /summaries/{summaryId} {
        allow read, write: if isOwner(userId);
      }

      // Rules for the 'notes' sub-collection
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
